// Fondo translucido: el blur lo aplica Hyprland (layerrule "dock").
import { Theme } from "../../ui/styles/theme.slint";

export struct DockApp {
    address: string,
    app-id: string,
    title: string,
    icon: image,
    has-icon: bool,
    letter: string,
    active: bool,
}

export global DockAdapter {
    callback hotspot-entered();
    callback hotspot-left();
    callback dock-entered();
    callback dock-left();
    callback tile-clicked(float);
    callback activate(string);
    callback apps-changed();
    in-out property <int> tile-count: 6;
    in-out property <[DockApp]> apps;
}

export component Dock inherits Window {
    title: "Dock";
    no-frame: true;
    background: transparent;
    width: 1366px;
    height: 70px;

    // Crece fijo hasta el tope (~1100px de barra), encoge despues.
    // Rust replica la formula (apply_input_for_count): padding 7/7/7,
    // 8px bajo el tile (carril 6 + pad 2), spacing 4. Cambiar ambos lados.
    property <length> tile-size: min(40px, max(24px, (1100px - 14px - (max(1, DockAdapter.tile-count) - 1) * 4px) / max(1, DockAdapter.tile-count)));
    property <length> tile-radius: tile-size * 0.2237;
    property <length> bar-radius: 16px;

    // Posicion en celdas (tile+gap), -1 = fuera. Un unico TouchArea.
    property <float> hover-pos: touch.has-hover && touch.mouse-y >= 7px && touch.mouse-y < 7px + tile-size
        ? cell(touch.mouse-x, tile-size, DockAdapter.tile-count) : -1;

    function cell(x: length, t: length, n: int) -> float {
        (x - 7px) / (t + 4px) < 0 || (x - 7px) / (t + 4px) >= n ? -1
        : (x - 7px) - floor((x - 7px) / (t + 4px)) * (t + 4px) >= t ? -1
        : floor((x - 7px) / (t + 4px))
    }

    VerticalLayout {
        alignment: end;
        padding-left: 0px;
        padding-right: 0px;
        padding-top: 6px;
        padding-bottom: 9px;

        HorizontalLayout {
            alignment: center;
            spacing: 0px;

            bar := Rectangle {
                border-radius: root.bar-radius;

                // Unico TouchArea de la barra: sin solapes no hay
                // exclusividad de hover y dock-left dispara siempre.
                touch := TouchArea {
                    changed has-hover => {
                        if (self.has-hover) {
                            DockAdapter.dock-entered();
                        } else {
                            DockAdapter.dock-left();
                        }
                    }
                    clicked => {
                        if (self.mouse-y >= 7px && self.mouse-y < 7px + root.tile-size) {
                            DockAdapter.tile-clicked(root.cell(self.mouse-x, root.tile-size, DockAdapter.tile-count));
                        }
                    }
                }

                background: @linear-gradient(180deg, #ffffff1f, #ffffff0d);
                border-width: 1px;
                border-color: #ffffff29;

                // Sin drop-shadow: Hyprland difuminaria la sombra fuera del contorno.

                HorizontalLayout {
                    alignment: center;
                    padding-left: 7px;
                    padding-right: 7px;
                    padding-top: 7px;
                    padding-bottom: 2px;
                    spacing: 4px;

                    for app[idx] in DockAdapter.apps: VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            width: root.tile-size;
                            height: root.tile-size;
                            border-radius: root.tile-radius;
                            clip: true;

                            background: root.hover-pos >= idx && root.hover-pos < idx + 1
                                ? @linear-gradient(135deg, Theme.surface-container-high, Theme.surface-container)
                                : @linear-gradient(135deg, Theme.surface-container, Theme.surface-dim);

                            if (app.has-icon): Image {
                                source: app.icon;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }

                            if (!app.has-icon): Text {
                                text: app.letter;
                                font-size: 18px;
                                color: #e6e6e6;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            drop-shadow-color: #00000059;
                            drop-shadow-blur: 6px;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-offset-x: 0px;
                        }

                        // Indicador de activa debajo del tile.
                        Rectangle {
                            height: 6px;

                            if (app.active): Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: #ffffffdd;
                                x: (parent.width - self.width) / 2;
                                y: 2px;
                            }
                        }
                    }
                }
            }
        }
    }
}
