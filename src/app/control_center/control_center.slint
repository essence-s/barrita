import { Theme } from "../../ui/styles/theme.slint";
import { Dashboard } from "dashboard/dashboard.slint";
import { ControlCenterAdapter } from "adapter.slint";

export component ControlCenter inherits Window {
    no-frame: true;
    width: 800px;
    height: 450px;
    background: transparent;

    TouchArea {
        changed has-hover => {
            ControlCenterAdapter.panel-hover(self.has-hover);
        }

        Rectangle {
            clip: true;

            content := Rectangle {
                // Reveal por estado, no por hover: al abrir el puntero esta
                // sobre la barra, asi que has-hover nunca se activaba y el
                // panel quedaba fuera del surface (invisible para siempre).
                y: -root.height;

                // Asimétrico: abrir puede tomar su tiempo, salir no. Al dejar
                // el hover el panel tiene que irse rápido, no arrastrarse.
                states [
                    opened when ControlCenterAdapter.is-open: {
                        y: 0px;
                        in {
                            animate y {
                                duration: 200ms;
                                easing: ease-out;
                            }
                        }
                        out {
                            animate y {
                                duration: 130ms;
                                easing: ease-in-quad;
                            }
                        }
                    }
                ]
                HorizontalLayout {
                    Rectangle {
                        Path {
                            x: 0;
                            y: 0;
                            width: 15px;
                            height: 15px;
                            fill: Theme.surface-container;

                            MoveTo {
                                x: 0;
                                y: 0;
                            }

                            LineTo {
                                x: 15;
                                y: 0;
                            }

                            LineTo {
                                x: 15;
                                y: 15;
                            }

                            ArcTo {
                                x: 0;
                                y: 0;
                                radius-x: 15;
                                radius-y: 15;
                                large-arc: false;
                                sweep: false;
                            }

                            Close { }
                        }
                    }

                    Rectangle {
                        background: Theme.surface-container;
                        width: parent.width - 30px;
                        border-bottom-left-radius: 15px;
                        border-bottom-right-radius: 15px;

                        VerticalLayout {
                            Rectangle {
                                height: 30px;
                            }

                            Dashboard {
                                height: parent.height - 30px;
                            }
                        }
                    }

                    Rectangle {
                        Path {
                            x: 0;
                            y: 0;
                            width: 15px;
                            height: 15px;
                            fill: Theme.surface-container;

                            MoveTo {
                                x: 0;
                                y: 0;
                            }

                            LineTo {
                                x: 15;
                                y: 0;
                            }

                            ArcTo {
                                x: 0;
                                y: 15;
                                radius-x: 15;
                                radius-y: 15;
                                large-arc: false;
                                sweep: false;
                            }

                            Close { }
                        }
                    }
                }
            }
        }
    }
}
