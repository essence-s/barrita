import { Theme } from "../../ui/styles/theme.slint";

export global ClockAdapter {
    in-out property <string> current-time: "12:00 PM";
    in-out property <string> current-date: "Mon 04/09";
}

export component ClockWidget {
    VerticalLayout {
        alignment: center;

        Rectangle {
            height: 28px;
            border-radius: 14px;
            background: Theme.surface;

            VerticalLayout {
                alignment: center;
                padding: 3px;

                Rectangle {
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.surface-container-high;
                    drop-shadow-color: #00000079;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-offset-x: 1px;
                    drop-shadow-blur: 3px;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: ClockAdapter.current-time;
                            font-family: Theme.font-family;
                            font-size: Theme.font-size;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "|";
                            font-family: Theme.font-family;
                            font-size: Theme.font-size;
                            color: #7b7b7b34;
                            vertical-alignment: center;
                        }

                        Text {
                            text: ClockAdapter.current-date;
                            font-family: Theme.font-family;
                            font-size: Theme.font-size;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
