import { Theme } from "../../ui/styles/theme.slint";

export global MediaAdapter {
    in-out property <string> status: "stopped";
    in-out property <bool> has-player: true;
    in-out property <string> title: "Sin música";
    in-out property <string> artist: "Artista";

    callback play-pause();
    callback next();
    callback previous();
}

export component MediaWidget {
    callback clicked;

    HorizontalLayout {
        horizontal-stretch: 0;
        alignment: center;
        height: 28px;

        TouchArea {
            Rectangle {
                background: Theme.workspaces_bg_color;
                border-radius: 20px;

                HorizontalLayout {
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        padding-left: 5px;
                        padding-right: 4px;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 12px;
                            background: #ffffff1d;
                            vertical-stretch: 0;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        padding: 2px;

                        Rectangle {
                            background: #6161616f;
                            border-radius: 6px;
                            drop-shadow-color: #00000079;
                            drop-shadow-offset-y: 1px;
                            drop-shadow-offset-x: 1px;
                            drop-shadow-blur: 3px;

                            HorizontalLayout {
                                spacing: 5px;
                                padding: 3px;

                                VerticalLayout {
                                    alignment: center;
                                    padding: -1px;
                                    padding-left: -0px;

                                    Image {
                                        source: MediaAdapter.has-player ? @image-url("../../assets/icons/motion_play.svg") : @image-url("../../assets/icons/music_off.svg");
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    text: MediaAdapter.artist;
                                    font-family: Theme.font-family;
                                    font-size: 10px;
                                    color: Theme.music_artist_color;
                                    max-width: 70px;
                                    overflow: elide;
                                }

                                Text {
                                    vertical-alignment: center;
                                    text: MediaAdapter.title;
                                    font-family: Theme.font-family;
                                    font-size: 10px;
                                    color: Theme.foreground;
                                    max-width: 100px;
                                    overflow: elide;
                                }

                                Rectangle {
                                    background: #464745;
                                    border-radius: 4px;
                                    drop-shadow-color: #00000079;
                                    drop-shadow-offset-y: 1px;
                                    drop-shadow-offset-x: 1px;
                                    drop-shadow-blur: 3px;

                                    VerticalLayout {
                                        TouchArea {
                                            clicked => {
                                                MediaAdapter.play-pause();
                                            }
                                            opacity: MediaAdapter.has-player ? 1 : 0.3;

                                            Image {
                                                source: MediaAdapter.status == "playing" ? @image-url("../../assets/icons/pause.svg") : @image-url("../../assets/icons/play_arrow.svg");
                                                width: 16px;
                                                height: 16px;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        padding-left: 4px;
                        padding-right: 5px;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 12px;
                            background: #ffffff1d;
                            vertical-stretch: 0;
                        }
                    }
                }
            }

            clicked => {
                root.clicked();
            }
        }
    }
}
