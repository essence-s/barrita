import { Theme } from "../../ui/styles/theme.slint";

export global BatteryAdapter {
    in-out property <string> current-percentage: "100%";
    in-out property <int> level: 100;
    in-out property <bool> charging: false;
    in-out property <bool> low: false;
}

export component BatteryWidget {
    Rectangle {
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;

            hover_rect := Rectangle {
                height: 30px;
                background: touch_area.has-hover ? #e7e8eb2f : transparent;
                border-width: 1px;
                border-color: touch_area.has-hover ? #ffffff0e : transparent;
                border-radius: 4px;

                VerticalLayout {
                    alignment: center;
                    padding-left: 6px;
                    padding-right: 6px;

                    Rectangle {
                        Rectangle {
                            x: 3px;
                            y: 10px;
                            width: (BatteryAdapter.level * 15px) / 100;
                            height: 6px;
                            background: BatteryAdapter.low ? #ff4444 : (BatteryAdapter.charging ? #90EE90 : Theme.foreground-icon);
                            clip: true;
                        }

                        Image {
                            source: @image-url("../../assets/icons/battery_android_0.svg");
                            width: 26px;
                            height: 26px;
                            image-fit: contain;
                            colorize: Theme.foreground-icon;
                        }
                    }
                }
            }
        }

        touch_area := TouchArea {
            // placeholder
        }
    }
}
