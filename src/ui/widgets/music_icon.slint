import { Theme } from "../styles/theme.slint";

export component MusicIconWidget {
    in-out property <string> status: "stopped";
    in-out property <bool> has-player: false;
    in-out property <string> title: "Sin música";
    in-out property <string> artist: "";
    in-out property <image> album-art;
    in-out property <int> frame-count: 0;
    in-out property <image> frame-0;
    in-out property <image> frame-1;
    in-out property <int> current-frame-index: 0;
    
    callback play-pause();
    callback next();
    callback previous();
    callback clicked;
    
    Rectangle {
        vertical-stretch: 1;

        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: start;
        
            TouchArea {         
                HorizontalLayout {
                    spacing: 4px;

                    // Icono centrado verticalmente
                    VerticalLayout {
                        alignment: center;
                        padding-right: 0px;
                        
                        icon-rect := Rectangle {
                            width: 43px;
                            
                        Image {
                            source: root.has-player ? (
                                root.current-frame-index == 0 ? root.frame-0 : root.frame-1
                            ) : @image-url("../../assets/icons/music_off.svg");
                            height: 22px;
                            image-fit: contain;
                        }
                        }
                    }
                    
                    // Album art container
                    VerticalLayout {
                        alignment: center;
                        
                        Rectangle {
                            clip: true;
                            width: 22px;
                            height: 22px;
                            border-radius: Theme.music_album_border_radius * 1px;
                            background: #a7a7a778;     
                            Image {               
                                source: root.album-art;
                                width: 22px;
                                height: 22px;
                                image-fit: cover;
                            }
                        }
                    }
                    
                    // Artist and Title
                    VerticalLayout {
                        alignment: center;
                        padding-top: 1px;
                        spacing: -2px;
                        
                        Text {
                            font-weight: 600;
                            vertical-alignment: bottom;
                            text: root.artist;
                            font-family: Theme.font-family;
                            font-size: 9.5px;
                            color: Theme.music_artist_color;
                            max-width: 150px;
                            overflow: elide;
                        }
                        
                        Text {
                            font-weight: 600;
                            vertical-alignment: bottom;
                            text: root.title;
                            font-family: Theme.font-family;
                            font-size: 11px;
                            color: Theme.foreground;
                            max-width: 150px;
                            overflow: elide;
                        }
                    }
                }
            
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}