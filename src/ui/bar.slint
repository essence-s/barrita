import { Theme } from "styles/theme.slint";
import { ClockWidget } from "../app/clock/clock.slint";
import { BatteryWidget } from "../app/battery/battery.slint";
import { NetworkWidget } from "../app/network/network.slint";
import { BluetoothWidget } from "../app/bluetooth/bluetooth.slint";
import { WorkspacesWidget } from "../app/workspaces/workspaces.slint";
import { ScreenshotWidget } from "../app/screenshot/screenshot.slint";
import { ColorizeWidget } from "../app/colorize/colorize.slint";
import { ArticleWidget } from "../app/article/article.slint";
import { MediaWidget } from "../app/media/media.slint";

export component StatusBarWindow inherits Window {
    title: "Barrita";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    x: 0;
    y: 0;
    width: 1366px;
    height: Theme.bar-height;
        
    in-out property <string> media-status: "stopped";
    in-out property <bool> media-has-player: false;
    in-out property <string> media-title: "Sin música";
    in-out property <string> media-artist: "";
    in-out property <image> media-album-art;
    in-out property <float> media-progress: 0.0;
    in-out property <string> media-progress-time: "0:00";
    in-out property <string> media-total-time: "0:00";
    in-out property <int> media-gif-frame-count: 0;
    in-out property <image> frame_0;
    in-out property <image> frame_1;
    in-out property <int> media-gif-current-frame-index: 0;
    
    in-out property <bool> music-popup-visible: false;
    
    callback popup_toggle();
    callback media_play_pause();
    callback media_next();
    callback media_previous();
    
    Rectangle {
        min-height: Theme.bar-height;
        
        HorizontalLayout {
            spacing: 0px;
            padding-left: 10px;
                               
            MediaWidget {
                horizontal-stretch: 1;
                max-width: parent.width / 3;
                status: root.media-status;
                has-player: root.media-has-player;
                title: root.media-title;
                artist: root.media-artist;
                album-art: root.media-album-art;
                frame-count: root.media-gif-frame-count;
                frame-0: root.frame_0;
                frame-1: root.frame_1;
                current-frame-index: root.media-gif-current-frame-index;

                clicked => {
                    root.popup_toggle();
                }
            }

            WorkspacesWidget {
                horizontal-stretch: 1;
                max-width: parent.width / 3;
            }
            
            HorizontalLayout {
                horizontal-stretch: 1;
                max-width: parent.width / 3;
                alignment: end;
                padding-right: 10px;
                
                ScreenshotWidget { }
                ColorizeWidget { }
                ArticleWidget { }
                
                ClockWidget { }
                
                BatteryWidget { }
                
                NetworkWidget { }
                
                BluetoothWidget { }
            }
        }
    }
}
